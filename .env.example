APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Docker UI port (docker compose maps this to nginx). Use host.docker.internal
# from inside containers to reach apps on the host (XAMPP, artisan serve, etc.).
APP_PORT=8180

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
# Host port mapped by docker compose (container still uses 3306).
DB_PORT=3307
DB_DATABASE=api_checker
DB_USERNAME=api_checker
DB_PASSWORD=secret
# Optional: full path to mysql clients if they are not on PATH (XAMPP).
# MYSQLDUMP_PATH=D:\xampp\mysql\bin\mysqldump.exe
# MYSQL_CLIENT_PATH=D:\xampp\mysql\bin\mysql.exe

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Seconds to wait after each scheduled address check (worker throttle).
CHECKING_DELAY_SECONDS=1
# Hard cap on scheduled checks processed per minute.
CHECKING_MAX_PER_MINUTE=30

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Max outbound check requests per host per minute (0 = unlimited).
# Site settings can override this per site.
CHECK_REQUESTS_PER_MINUTE=32
# Max size of a portable site JSON import (kilobytes).
SITE_TRANSFER_MAX_UPLOAD_KB=10240
# Retry a check when the target responds 429 (1 = no retry)
CHECK_429_RETRIES=3
CHECK_429_BACKOFF_MS=2000
CHECK_429_MAX_WAIT_MS=10000
